<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="True" runFullAccess="False" id="106" name="保存3D模型到FileMaker">
    <Step enable="True" id="89" name="# (comment)">
      <Text>用途：接收 WebViewer 上传的 .glb 3D 场景模型 Base64，解码后存入 WMPSES_试卷场景::Scene3DModel 容器字段</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$payload</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $payload ; "examId" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$examId</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $payload ; "fileName" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$fileName</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $payload ; "base64" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$b64</Name>
    </Step>
    <Step enable="True" id="68" name="If">
      <Calculation><![CDATA[IsEmpty ( $b64 )]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[False]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Get ( LayoutName )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$originLayout</Name>
    </Step>
    <Step enable="True" id="6" name="Go to Layout">
      <LayoutDestination value="SelectedLayout"/>
      <Layout id="1" name="WMPSES_试卷场景"/>
    </Step>
    <Step enable="True" id="22" name="Enter Find Mode">
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="76" name="Set Field">
      <Calculation><![CDATA["==" & If ( IsEmpty ( $examId ) ; "WMPSES-1.1.1-V1" ; $examId )]]></Calculation>
      <Field table="WMPSES_试卷场景" id="1" name="pk_ExamID"/>
    </Step>
    <Step enable="True" id="28" name="Perform Find">
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="68" name="If">
      <Calculation><![CDATA[Get ( FoundCount ) > 0]]></Calculation>
    </Step>
    <Step enable="True" id="76" name="Set Field">
      <Calculation><![CDATA[If ( IsEmpty ( $fileName ) ; "scene.glb" ; $fileName )]]></Calculation>
      <Field table="WMPSES_试卷场景" id="14" name="Scene3DModelName"/>
    </Step>
    <Step enable="True" id="76" name="Set Field">
      <Calculation><![CDATA[Base64Decode ( $b64 ; If ( IsEmpty ( $fileName ) ; "scene.glb" ; $fileName ) )]]></Calculation>
      <Field table="WMPSES_试卷场景" id="15" name="Scene3DModel"/>
    </Step>
    <Step enable="True" id="75" name="Commit Records/Requests">
      <NoInteract state="True"/>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="6" name="Go to Layout">
      <LayoutDestination value="LayoutNameByCalc"/>
      <Layout>
        <Calculation><![CDATA[$originLayout]]></Calculation>
      </Layout>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
  </Script>
</fmxmlsnippet>
