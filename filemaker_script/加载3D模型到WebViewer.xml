<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="True" runFullAccess="False" id="105" name="加载3D模型到WebViewer">
    <Step enable="True" id="89" name="# (comment)">
      <Text>用途：读取 WMPSES_试卷场景::Scene3DModel 容器中的 .glb 真 3D 模型，Base64 编码后注入 WebViewer</Text>
    </Step>
    <Step enable="True" id="68" name="If">
      <Calculation><![CDATA[IsEmpty ( WMPSES_试卷场景::Scene3DModel )]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[False]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[If ( IsEmpty ( WMPSES_试卷场景::Scene3DModelName ) ; GetContainerAttribute ( WMPSES_试卷场景::Scene3DModel ; "filename" ) ; WMPSES_试卷场景::Scene3DModelName )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$modelName</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Base64EncodeRFC ( 4648 ; WMPSES_试卷场景::Scene3DModel )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$glbBase64</Name>
    </Step>
    <Step enable="True" id="200" name="Perform JavaScript in Web Viewer">
      <ObjectName>
        <Calculation><![CDATA["WV_ExamStage"]]></Calculation>
      </ObjectName>
      <FunctionName>
        <Calculation><![CDATA["FMExam.loadGlbBase64"]]></Calculation>
      </FunctionName>
      <Parameters>
        <Parameter>
          <Calculation><![CDATA[$glbBase64]]></Calculation>
        </Parameter>
        <Parameter>
          <Calculation><![CDATA[$modelName]]></Calculation>
        </Parameter>
      </Parameters>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
  </Script>
</fmxmlsnippet>
