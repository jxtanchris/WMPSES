<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="True" runFullAccess="False" id="103" name="保存题库热点配置">
    <Step enable="True" id="89" name="# (comment)">
      <Text>用途：接收教师在 WebViewer 编辑模式修改后的热点坐标与题库，同步更新至 FileMaker 三张关系表</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Get ( LayoutName )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$originLayout</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$payload</Name>
    </Step>
    <Step enable="True" id="68" name="If">
      <Calculation><![CDATA[IsEmpty ( $payload ) or Left ( JSONGetElement ( $payload ; "" ) ; 1 ) = "?"]]></Calculation>
    </Step>
    <Step enable="True" id="87" name="Show Custom Dialog">
      <Title>
        <Calculation><![CDATA["题库保存失败"]]></Calculation>
      </Title>
      <Message>
        <Calculation><![CDATA["未接收到有效的题库 JSON 参数"]]></Calculation>
      </Message>
      <Buttons>
        <Button CommitState="True">
          <Name>
            <Calculation><![CDATA["确定"]]></Calculation>
          </Name>
        </Button>
      </Buttons>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[False]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $payload ; "questionBank" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$bankJson</Name>
    </Step>
    <Step enable="True" id="68" name="If">
      <Calculation><![CDATA[IsEmpty ( $bankJson )]]></Calculation>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[$payload]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$bankJson</Name>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="89" name="# (comment)">
      <Text>调用关系表 Upsert 子脚本写入 WMPSES_试卷场景 / WMPSES_设备热点 / WMPSES_习题库</Text>
    </Step>
    <Step enable="True" id="1" name="Perform Script">
      <Calculation><![CDATA[$bankJson]]></Calculation>
      <Script id="104" name="初始化导入题库JSON到FileMaker关系表"/>
    </Step>
    <Step enable="True" id="6" name="Go to Layout">
      <LayoutDestination value="LayoutNameByCalc"/>
      <Layout>
        <Calculation><![CDATA[$originLayout]]></Calculation>
      </Layout>
    </Step>
    <Step enable="True" id="87" name="Show Custom Dialog">
      <Title>
        <Calculation><![CDATA["保存成功"]]></Calculation>
      </Title>
      <Message>
        <Calculation><![CDATA["热点坐标与习题库已同步更新至 FileMaker 关系表。"]]></Calculation>
      </Message>
      <Buttons>
        <Button CommitState="True">
          <Name>
            <Calculation><![CDATA["确定"]]></Calculation>
          </Name>
        </Button>
      </Buttons>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
  </Script>
</fmxmlsnippet>
