# WMPSES 70~200人高并发考场部署配置（复制为 .env 后按需修改）

# 对外 HTTP 入口端口（考场浏览器访问 http://<服务器IP>:8080）
WMPSES_HTTP_PORT=8080

# MySQL 8.0 配置
WMPSES_MYSQL_ROOT_PASSWORD=root123456
WMPSES_MYSQL_DATABASE=wmpses
WMPSES_MYSQL_USER=wmpses
WMPSES_MYSQL_PASSWORD=wmpses123456
WMPSES_MYSQL_EXPOSE_PORT=3306
WMPSES_MYSQL_POOL_SIZE=24

# FastAPI / Uvicorn 并发 Worker 数（建议设为服务器 CPU 核数，如 4）
WMPSES_WORKERS=4

# 无状态签名 Token 密钥（生产环境请务必替换为随机长字符串）
WMPSES_AUTH_SECRET=please-replace-with-a-random-long-secret-key
WMPSES_TOKEN_TTL=43200
